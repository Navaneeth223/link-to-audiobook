{
  "name": "private-story-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint src tests eslint.config.js playwright.config.ts vite.config.ts vitest.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{js,ts,json}\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:e2e": "npm run build && playwright test",
    "test:visual": "npm run build && playwright test --grep @visual",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-node": "^3.7.3",
    "@breezystack/lamejs": "1.2.7",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "@vitejs/plugin-react": "latest",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "fflate": "0.8.2",
    "helmet": "^8.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "^4.10.38",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^26.6.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "latest",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "latest"
  }
}
